generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Asignaciones {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  activa       Boolean   @default(true)
  comentario   String?
  calificacion Float?
  trabajoId    String
  revisorId    String    @db.VarChar(255)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  closeAt      DateTime? @db.Timestamptz(6)
  revisor     Usuarios  @relation(fields: [revisorId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_asignaciones_revisor")
  trabajo     Trabajos  @relation(fields: [trabajoId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_asignaciones_trabajo")

  @@unique([trabajoId, revisorId], map: "uq_asignaciones_trabajo_revisor")
  @@index([activa], map: "idx_asignaciones_activa")
  @@index([revisorId], map: "idx_asignaciones_revisorid")
  @@index([trabajoId], map: "idx_asignaciones_trabajoid")
}

model Coautores {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  idTrabajo String
  nombre    String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  trabajo  Trabajos @relation(fields: [idTrabajo], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_coautores_trabajo")

  @@index([idTrabajo], map: "idx_coautores_idtrabajo")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Convocatorias {
  id           String     @id @db.VarChar(255)
  titulo       String     @db.VarChar(255)
  descripcion  String
  fecha_inicio DateTime   @db.Timestamptz(6)
  fecha_cierre DateTime   @db.Timestamptz(6)
  archivo_url  String
  activa       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @db.Timestamptz(6)
  trabajos     Trabajos[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model CriteriosEvaluacion {
  id                  String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  nombre              String       @db.VarChar(255)
  descripcion         String
  grupo               GrupoRubrica
  descripcion_puntaje String[]     @default([])
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @default(now()) @db.Timestamptz(6)
}

model Tokens {
  token     String    @id @db.VarChar(255)
  email     String    @db.VarChar(255)
  tipo      TipoToken
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt DateTime  @db.Timestamptz(6)

  @@index([email, tipo], map: "idx_tokens_email_tipo")
  @@index([expiresAt], map: "idx_tokens_expiresat")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Trabajos {
  id                 String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  archivo_url        String
  estado             EstadoTrabajo  @default(REGISTRADO)
  titulo             String         @db.VarChar(255)
  tipo               GrupoRubrica
  presencial         Boolean?
  nvl_ia             Float?
  nvl_plagio         Float?
  calificacion_final Float?
  referencia_pago    String?        @unique @db.VarChar(255)
  usuarioId          String         @db.VarChar(255)
  convocatoriaId     String         @db.VarChar(255)
  createdAt          DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @db.Timestamptz(6)
  asignaciones       Asignaciones[]
  coautores          Coautores[]
  convocatoria      Convocatorias  @relation(fields: [convocatoriaId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_trabajos_convocatoria")
  usuario           Usuarios       @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_trabajos_usuario")

  @@index([convocatoriaId], map: "idx_trabajos_convocatoriaid")
  @@index([estado], map: "idx_trabajos_estado")
  @@index([usuarioId], map: "idx_trabajos_usuarioid")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Usuarios {
  id             String         @id @db.VarChar(255)
  email          String         @unique @db.VarChar(255)
  rfc            String?        @unique @db.VarChar(255)
  curp           String?        @unique @db.VarChar(255)
  numero_control String?        @unique @db.VarChar(255)
  nombre         String         @db.VarChar(255)
  apellidoP      String         @db.VarChar(255)
  apellidoM      String         @db.VarChar(255)
  password       String         @db.VarChar(255)
  rol            Rol            @default(AUTOR)
  activa         Boolean        @default(false)
  bloqueada         Boolean        @default(false)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @db.Timestamptz(6)
  asignacionesComoRevisor   Asignaciones[]
  trabajos       Trabajos[]
}

enum EstadoTrabajo {
  EN_REVISION
  ACEPTADO
  RECHAZADO
  REGISTRADO
}

enum GrupoRubrica {
  DIFUSION
  DIVULGACION
}

enum TipoToken {
  VERIFICACION
  RESTABLECIMIENTO
  INVITACION
}

enum Rol {
  AUTOR
  REVISOR
  COMITE
  ADMIN
}
